# Copy to .env.local for local dev. In production these come from Secret Manager (deploy/cloudrun.sh).

# --- Sign-in (pick one) ---
# Google sign-in, locked to one email. Also grants Calendar read-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL=
# Or a simple passcode until Google OAuth is set up.
APP_PASSCODE=
# Required in production: signs the session cookie. Generate with `openssl rand -base64 32`.
SESSION_SECRET=
# Public URL in production (used for the OAuth redirect), e.g. https://myguru-xxxx.a.run.app
APP_URL=

# --- Guru AI (optional; rule-based fallbacks when unset) ---
ANTHROPIC_API_KEY=
# GURU_MODEL=claude-sonnet-5-5
# GURU_FAST_MODEL=claude-haiku-4-5

# --- Locale ---
APP_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_CURRENCY=INR
OWNER_NAME=Shri

# --- Machine endpoints ---
CRON_SECRET=          # Cloud Scheduler -> /api/jobs/*
HEALTH_SYNC_TOKEN=    # Android app -> /api/sync/health

# --- Web push (generate with `npx web-push generate-vapid-keys`) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Portfolio (read-only). "manual" until the broker is chosen. ---
BROKER=manual
# KITE_API_KEY=
# KITE_ACCESS_TOKEN=

# --- Targets ---
STEP_TARGET=8000
LIFE_WEEKLY_TARGET_MIN=420

# --- Storage ---
DATABASE_PATH=./data/myguru.db
